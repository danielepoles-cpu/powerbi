	/// BBP: ON GOING if at least one open document exists, FINAL otherwise (uses the Open Docs proxy).
	measure 'Vendor Status' = IF(ISEMPTY('pbi F_DWH_REFERENCE_VENDORS'), BLANK(), IF([Open Docs] > 0, "ON GOING", "FINAL"))
