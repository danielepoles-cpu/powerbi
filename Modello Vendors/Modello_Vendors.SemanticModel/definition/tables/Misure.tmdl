	/// PROXY: BBP defines open = latest version with Decision Code <> 1F/4F, but Decision Code is not yet available in the DWH. Until then a document is open while it has no Actual Return Date.
	measure 'Open Docs' = CALCULATE(DISTINCTCOUNT('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]), 'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE, ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]))
