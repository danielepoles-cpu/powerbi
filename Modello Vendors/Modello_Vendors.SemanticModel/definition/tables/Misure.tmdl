			RETURN SWITCH(
						    Ev,
						    "Issue", MAX('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]),
						    "Return", MAX('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]),
