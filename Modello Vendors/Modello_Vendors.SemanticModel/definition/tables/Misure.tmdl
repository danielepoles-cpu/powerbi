	/// PROXY (see Open Docs). Key documents only.
	measure 'Open Key Docs' = CALCULATE(DISTINCTCOUNT('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]), 'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE, ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]), 'pbi F_DWH_REFERENCE_VENDORS'[ENGINEERING_KEY_DOCUMENTS] = "Yes")
