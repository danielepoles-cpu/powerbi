	/// BBP: planned date of the first RFI (phase-based).
	measure 'DB Planned 1st Issue' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			RETURN SWITCH(
						    Ev,
						    "Issue", MIN('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_ISSUE_DATE]),
						    "Return", MIN('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_RETURN_DATE]),
						    MIN('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE])
						)
		formatString: dd/mm/yy
		displayFolder: Claude BBP\4 Final Data Book
		lineageTag: 70a8de1c-ff0d-41b5-b3b6-e497795bd59e

	/// BBP: min Forecast date among the RFIs (phase-based).
	measure 'DB Forecast 1st Issue' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			RETURN SWITCH(
						    Ev,
						    "Issue", MIN('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE]),
						    "Return", MIN('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE]),
						    MIN('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])
						)
		formatString: dd/mm/yy
