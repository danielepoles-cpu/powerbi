		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CPY Delay' = ```
			
			VAR ViewMode    = SELECTEDVALUE('DIM_ViewMode'[ViewMode], "Pending")
			VAR LastRefresh = MAX(LastRefresh[LastRefresh])
			
			RETURN
			IF(
			    ViewMode = "Pending",
			    
			    -- =========================================================================
			    -- PENDING: Considera solo i documenti aperti presso il cliente
			    --  - Invio al cliente effettuato (ACTUAL_ISSUE_DATE presente)
			    --  - Risposta NON ancora ricevuta (ACTUAL_CPY_REPLY_DATE vuota)
			    --  - Flag risposta necessaria (REPLY_NEEDED_FLAG <> "N")
			    --  - Calcola il ritardo accumulato ad oggi (LastRefresh - PLANNED_CPY_REPLY_DATE)
			    -- =========================================================================
			    AVERAGEX(
			        FILTER(
			            'pbi F_DWH_REFERENCE_VENDORS',
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			            'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_REPLY_REQUIRED] <> "N" &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]) &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_CPY_REPLY_DATE]) &&
			            ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[CLIENT_RESPONSE_DATE])
			        ),
			        DATEDIFF('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_CPY_REPLY_DATE], LastRefresh, DAY)
			    ),
			    
			    -- =========================================================================
			    -- OVERALL: Considera tutti i documenti inviati al cliente (passati e presenti)
			    --  - Se concluso (ACTUAL_CPY_REPLY_DATE presente) -> diff(Planned, Actual)
			    --  - Se aperto (ACTUAL_CPY_REPLY_DATE vuota)     -> diff(Planned, LastRefresh)
			    -- =========================================================================
			    AVERAGEX(
			        FILTER(
			            'pbi F_DWH_REFERENCE_VENDORS',
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			            'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_REPLY_REQUIRED] <> "N" &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]) &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_CPY_REPLY_DATE])
			        ),
			        VAR ActualReply  = 'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_RESPONSE_DATE]
			        VAR PlannedReply = 'pbi F_DWH_REFERENCE_VENDORS'[PLANNED_CPY_REPLY_DATE]
			        RETURN
			        IF(
			            NOT ISBLANK(ActualReply),
			            DATEDIFF(PlannedReply, ActualReply, DAY),
			            DATEDIFF(PlannedReply, LastRefresh, DAY)
			        )
			    )
			)
			```
		displayFolder: Misure\Vendor Follow-Up
		lineageTag: ab522920-a0d3-4037-8875-cf2f949b5b0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Return Delay' = ```
			
			VAR ViewMode    = SELECTEDVALUE('DIM_ViewMode'[ViewMode], "Pending")
			VAR LastRefresh = MAX(LastRefresh[LastRefresh])
			
			RETURN
			IF(
			    ViewMode = "Pending",
			    
			    -- =========================================================================
			    -- PENDING: Considera solo i documenti in corso di revisione/return
			    --  - Forecast Return Date presente
			    --  - Return finale NON ancora avvenuto (ACTUAL_RETURN_DATE vuota)
			    --  - Calcola il ritardo accumulato ad oggi (LastRefresh - FORECAST_RETURN_DATE)
			    -- =========================================================================
			    AVERAGEX(
			        FILTER(
			            'pbi F_DWH_REFERENCE_VENDORS',
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE]) &&
			            ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])
			        ),
			        DATEDIFF('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE], LastRefresh, DAY)
			    ),
			    
			    -- =========================================================================
			    -- OVERALL: Considera tutti i documenti della sorgente con Forecast Return
			    --  - Se concluso (ACTUAL_RETURN_DATE presente) -> diff(Forecast, Actual)
			    --  - Se aperto (ACTUAL_RETURN_DATE vuota)     -> diff(Forecast, LastRefresh)
			    -- =========================================================================
			    AVERAGEX(
			        FILTER(
			            'pbi F_DWH_REFERENCE_VENDORS',
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])
			        ),
			        VAR ActualReturn   = 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]
			        VAR ForecastReturn = 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE]
			        RETURN
			        IF(
			            NOT ISBLANK(ActualReturn),
			            DATEDIFF(ForecastReturn, ActualReturn, DAY),
			            DATEDIFF(ForecastReturn, LastRefresh, DAY)
			        )
			    )
			)
			```
		displayFolder: Misure\Vendor Follow-Up
		lineageTag: e65fd1b2-433b-4614-93e0-218133c4575c

	measure 'Last Update' = FORMAT(MAX(LastRefresh[LastRefresh]), "dd/MM/yyyy")
		displayFolder: Misure\Vendor Follow-Up
		lineageTag: c0da4b16-ed42-46f8-b78e-9de95052e7f9

	/// BBP: distinct VERSION_LABEL.
	measure 'Version Count' = DISTINCTCOUNT('pbi F_DWH_REFERENCE_VENDORS'[VERSION_LABEL])
		formatString: 0
		displayFolder: Claude BBP\1 Base
		lineageTag: 1cef28da-1901-4f11-8e30-c873acb68e5a

	/// BBP: sum of estimated hours per document (latest version). Null or 0 -> default 1 (BBP rule).
	measure 'Estimated Hours' =
			SUMX(
			    VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			    VAR h = CALCULATE(MAX('pbi F_DWH_REFERENCE_VENDORS'[ESTIMATED_HOURS]), 'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE)
			    RETURN IF(ISBLANK(h) || h = 0, 1, h)
			)
		formatString: #,0.##
		displayFolder: Claude BBP\1 Base
		lineageTag: 026f0c41-4b86-4c30-bed8-e8c07f759f11

	/// BBP: planned progress at the update date. Per document, progress % of the RFI with the latest planned date <= today, weighted by estimated hours. Not available for event Return (RFI list has no return dates).
	measure 'Planned %' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			VAR T0 = INT(MAX(LastRefresh[LastRefresh]))
			VAR Num =
			    SUMX(
			        VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			        VAR ref = 'pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]
			        VAR h = CALCULATE(MAX('pbi F_DWH_REFERENCE_VENDORS'[ESTIMATED_HOURS]), 'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE)
			        VAR hh = IF(ISBLANK(h) || h = 0, 1, h)
			        VAR pct = SWITCH(
					    Ev,
					    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_ELENCO_RFI_VENDORS', NOT ISBLANK('pbi F_DWH_ELENCO_RFI_VENDORS'[PLANNED_ISSUE_DATE]) && 'pbi F_DWH_ELENCO_RFI_VENDORS'[PLANNED_ISSUE_DATE] <= T0), 'pbi F_DWH_ELENCO_RFI_VENDORS'[PLANNED_ISSUE_DATE], DESC), 'pbi F_DWH_ELENCO_RFI_VENDORS'[PERCENTAGE]), TREATAS({ref}, 'pbi F_DWH_ELENCO_RFI_VENDORS'[REFERENCE])),
					    "Return", BLANK(),
					    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_ELENCO_RFI_VENDORS', NOT ISBLANK('pbi F_DWH_ELENCO_RFI_VENDORS'[PLANNED_SUBMISSION_DATE]) && 'pbi F_DWH_ELENCO_RFI_VENDORS'[PLANNED_SUBMISSION_DATE] <= T0), 'pbi F_DWH_ELENCO_RFI_VENDORS'[PLANNED_SUBMISSION_DATE], DESC), 'pbi F_DWH_ELENCO_RFI_VENDORS'[PERCENTAGE]), TREATAS({ref}, 'pbi F_DWH_ELENCO_RFI_VENDORS'[REFERENCE]))
					)
			        RETURN COALESCE(pct, 0) / 100 * hh
			    )
			RETURN DIVIDE(Num, [Estimated Hours])
		formatString: 0%
		displayFolder: Claude BBP\1 Base
		lineageTag: 41b67a66-aa5f-4c17-b3f5-fd7d0c7b053b

	/// BBP: actual progress at the update date. Per document, progress % of the RFI with the latest actual date <= today, weighted by estimated hours.
	measure 'Actual %' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			VAR T0 = INT(MAX(LastRefresh[LastRefresh]))
			VAR Num =
			    SUMX(
			        VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			        VAR ref = 'pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]
			        VAR h = CALCULATE(MAX('pbi F_DWH_REFERENCE_VENDORS'[ESTIMATED_HOURS]), 'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE)
			        VAR hh = IF(ISBLANK(h) || h = 0, 1, h)
			        VAR pct = SWITCH(
					    Ev,
					    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_ELENCO_RFI_VENDORS', NOT ISBLANK('pbi F_DWH_ELENCO_RFI_VENDORS'[ACTUAL_ISSUE_DATE]) && 'pbi F_DWH_ELENCO_RFI_VENDORS'[ACTUAL_ISSUE_DATE] <= T0), 'pbi F_DWH_ELENCO_RFI_VENDORS'[ACTUAL_ISSUE_DATE], DESC), 'pbi F_DWH_ELENCO_RFI_VENDORS'[PERCENTAGE]), TREATAS({ref}, 'pbi F_DWH_ELENCO_RFI_VENDORS'[REFERENCE])),
					    "Return", BLANK(),
					    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_ELENCO_RFI_VENDORS', NOT ISBLANK('pbi F_DWH_ELENCO_RFI_VENDORS'[ACTUAL_SUBMISSION_DATE]) && 'pbi F_DWH_ELENCO_RFI_VENDORS'[ACTUAL_SUBMISSION_DATE] <= T0), 'pbi F_DWH_ELENCO_RFI_VENDORS'[ACTUAL_SUBMISSION_DATE], DESC), 'pbi F_DWH_ELENCO_RFI_VENDORS'[PERCENTAGE]), TREATAS({ref}, 'pbi F_DWH_ELENCO_RFI_VENDORS'[REFERENCE]))
					)
			        RETURN COALESCE(pct, 0) / 100 * hh
			    )
			RETURN DIVIDE(Num, [Estimated Hours])
		formatString: 0%
		displayFolder: Claude BBP\1 Base
		lineageTag: fb26d3f7-dee4-450e-ace1-cb12ddbcf064

	/// BBP: Planned % x Estimated Hours.
	measure 'Earned Hours (Planned)' = [Planned %] * [Estimated Hours]
