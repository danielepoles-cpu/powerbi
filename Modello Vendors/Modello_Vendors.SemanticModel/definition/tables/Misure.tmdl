		lineageTag: 2c1cd924-8809-4b83-8538-0c3402747037

	/// BBP: no Actual date on the First RFI.
	measure 'DB Docs Missing' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			VAR Docs =
			    ADDCOLUMNS(
			        VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			        "FirstAct", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE])),
						    "Return", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
						    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]))
						),
			        "LastAct", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE])),
						    "Return", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
						    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]))
						)
			    )
			RETURN COUNTROWS(FILTER(Docs, ISBLANK([FirstAct])))
		formatString: 0
		displayFolder: Claude BBP\4 Final Data Book
		lineageTag: 4761e6f6-5633-4807-9531-0fdb9b730a52

	/// BBP: Actual on the First RFI but not on the Last RFI.
	measure 'DB Docs First Issue' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			VAR Docs =
			    ADDCOLUMNS(
			        VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			        "FirstAct", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE])),
						    "Return", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
						    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]))
						),
			        "LastAct", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE])),
						    "Return", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
						    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]))
						)
			    )
			RETURN COUNTROWS(FILTER(Docs, NOT ISBLANK([FirstAct]) && ISBLANK([LastAct])))
		formatString: 0
		displayFolder: Claude BBP\4 Final Data Book
		lineageTag: 5e79e748-79ab-40be-95f8-5dbf3b5747c6

	/// BBP: Actual on both First and Last RFI.
	measure 'DB Docs Final Issue' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			VAR Docs =
			    ADDCOLUMNS(
			        VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			        "FirstAct", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE])),
						    "Return", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
						    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE], ASC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]))
						),
			        "LastAct", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE])),
						    "Return", CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
						    CALCULATE(MAXX(TOPN(1, FILTER('pbi F_DWH_REFERENCE_VENDORS', NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE], DESC), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]))
						)
			    )
			RETURN COUNTROWS(FILTER(Docs, NOT ISBLANK([FirstAct]) && NOT ISBLANK([LastAct])))
		formatString: 0
		displayFolder: Claude BBP\4 Final Data Book
		lineageTag: 0cd05956-daa9-4925-9ec1-fc9c70c698eb

	/// Value for the pie chart (category = DIM_DataBookStatus[Status]).
	measure 'DB Docs by Status' =
			SWITCH(
			    SELECTEDVALUE(DIM_DataBookStatus[Status]),
			    "First Issue", [DB Docs First Issue],
			    "Final Issue", [DB Docs Final Issue],
			    "Missing", [DB Docs Missing],
			    BLANK()
			)
		formatString: 0
		displayFolder: Claude BBP\4 Final Data Book
		lineageTag: ccbafd1d-5191-479b-b489-37c445ce3e29

	/// BBP: documents whose First RFI (min open Forecast date) falls in the period. Past dates are assigned to the current period.
	measure 'DB Forecast 1st Issue Count' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			VAR T0 = INT(MAX(LastRefresh[LastRefresh]))
			VAR pS = MIN(DIM_Calendar[Date])
			VAR pE = MAX(DIM_Calendar[Date])
			VAR Docs =
			    ADDCOLUMNS(
			        VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			        "DocDate", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MINX(FILTER('pbi F_DWH_REFERENCE_VENDORS', ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]) && NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])),
						    "Return", CALCULATE(MINX(FILTER('pbi F_DWH_REFERENCE_VENDORS', ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]) && NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])),
						    CALCULATE(MINX(FILTER('pbi F_DWH_REFERENCE_VENDORS', ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) && NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE]))
						)
			    )
			VAR c =
			    COUNTROWS(
			        FILTER(
			            Docs,
			            VAR d = [DocDate]
			            VAR dd = IF(d < T0, T0, d)
			            RETURN NOT ISBLANK(d) && dd >= pS && dd <= pE
			        )
			    )
			RETURN IF(c = 0, BLANK(), c)
		formatString: 0
		displayFolder: Claude BBP\4 Final Data Book
		lineageTag: e295ba6c-e4fd-4650-be1a-516f4d1761e4

	/// BBP: documents whose Last RFI (max open Forecast date) falls in the period. Past dates are assigned to the current period.
	measure 'DB Forecast Final Issue Count' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			VAR T0 = INT(MAX(LastRefresh[LastRefresh]))
			VAR pS = MIN(DIM_Calendar[Date])
			VAR pE = MAX(DIM_Calendar[Date])
			VAR Docs =
			    ADDCOLUMNS(
			        VALUES('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]),
			        "DocDate", SWITCH(
						    Ev,
						    "Issue", CALCULATE(MAXX(FILTER('pbi F_DWH_REFERENCE_VENDORS', ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]) && NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_ISSUE_DATE])),
						    "Return", CALCULATE(MAXX(FILTER('pbi F_DWH_REFERENCE_VENDORS', ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]) && NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_RETURN_DATE])),
						    CALCULATE(MAXX(FILTER('pbi F_DWH_REFERENCE_VENDORS', ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) && NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE])), 'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE]))
						)
			    )
			VAR c =
			    COUNTROWS(
			        FILTER(
			            Docs,
			            VAR d = [DocDate]
			            VAR dd = IF(d < T0, T0, d)
			            RETURN NOT ISBLANK(d) && dd >= pS && dd <= pE
			        )
			    )
			RETURN IF(c = 0, BLANK(), c)
		formatString: 0
		displayFolder: Claude BBP\4 Final Data Book
		lineageTag: a0c3fe0e-574e-44ea-8b23-18aaf47d0833

	/// BBP: average target days for DC Acknowledge (TAP table).
	measure 'WF DC Acknowledge Target Time Frame (av.)' =
			AVERAGEX(
			    FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        TRUE() &&
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_ACK_TARGET]))
			    ),
			    RELATED('pbi PAR_WP'[TBD_ACK_TARGET])
			)
		formatString: 0.0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: f7a80ed2-ae17-4a8f-a380-cda5ee8e77c7

	/// BBP: average actual days for DC Acknowledge (actual - previous milestone).
	measure 'WF DC Acknowledge Actual Time Frame (av.)' =
			AVERAGEX(
			    FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        TRUE() &&
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_ACK_TARGET]))
			    ), NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE])),
			    DATEDIFF('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE], 'pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE], DAY)
			)
		formatString: 0.0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 34e6d7f3-22bf-45c9-a13c-13175355f618

	/// BBP: documents waiting for DC Acknowledge. Documents with an Actual Return Date are excluded (phase executed but date unknown).
	measure 'WF DC Acknowledge Pending' =
			COUNTROWS(
			    FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        TRUE() &&
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_ACK_TARGET]))
			    ), ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE]) && ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]))
			)
		formatString: 0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 2e68b547-b5d3-4058-a116-6b5502040a31

	/// BBP: average delay of pending documents: today - (previous milestone + target).
	measure 'WF DC Acknowledge Pending Delay (av.)' =
			VAR T0 = INT(MAX(LastRefresh[LastRefresh]))
			RETURN
			AVERAGEX(
			    FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        TRUE() &&
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_ACK_TARGET]))
			    ), ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE]) && ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
			    DATEDIFF('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE] + RELATED('pbi PAR_WP'[TBD_ACK_TARGET]), T0, DAY)
			)
		formatString: 0.0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 0381e4d7-b92a-428e-bee3-abfa3d572992

	/// BBP: completed documents per delay bucket for DC Acknowledge (category = DIM_DelayBucket[Bucket]).
	measure 'WF DC Acknowledge Delay Docs' =
			VAR b = SELECTEDVALUE(DIM_DelayBucket[Bucket])
			RETURN
			COUNTROWS(
			    FILTER(
			        FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        TRUE() &&
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_ACK_TARGET]))
			    ), NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE])),
			        VAR dl = DATEDIFF('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE] + RELATED('pbi PAR_WP'[TBD_ACK_TARGET]), 'pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE], DAY)
			        RETURN
			            SWITCH(
			                TRUE(),
			                b = "On time", dl <= 0,
			                b = "Delay 0-7 dd", dl > 0 && dl <= 7,
			                b = "Delay 8-14 dd", dl > 7 && dl <= 14,
			                b = "Delay > 14 dd", dl > 14,
			                FALSE()
			            )
			    )
			)
		formatString: 0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 1564436e-8758-4cfd-b9ae-8157978a75a2

	/// BBP: average target days for DC Formal Review Start (TAP table).
	measure 'WF DC Formal Review Start Target Time Frame (av.)' =
			AVERAGEX(
			    FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        'pbi F_DWH_REFERENCE_VENDORS'[TBD_REVIEW_NEEDED] <> "N" &&
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE]) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_FR_START_TARGET]))
			    ),
			    RELATED('pbi PAR_WP'[TBD_FR_START_TARGET])
			)
		formatString: 0.0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: de29f331-aad4-47ad-96db-824fc1b6774e

	/// BBP: average actual days for DC Formal Review Start (actual - previous milestone).
	measure 'WF DC Formal Review Start Actual Time Frame (av.)' =
			AVERAGEX(
			    FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        'pbi F_DWH_REFERENCE_VENDORS'[TBD_REVIEW_NEEDED] <> "N" &&
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE]) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_FR_START_TARGET]))
			    ), NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_FR_START_DATE])),
			    DATEDIFF('pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_ACK_DATE], 'pbi F_DWH_REFERENCE_VENDORS'[TBD_ACTUAL_FR_START_DATE], DAY)
			)
		formatString: 0.0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 14fe8aec-2f34-43fd-b9dc-7087b802308f

	/// BBP: documents waiting for DC Formal Review Start. Documents with an Actual Return Date are excluded (phase executed but date unknown).
	measure 'WF DC Formal Review Start Pending' =
			COUNTROWS(
			    FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
