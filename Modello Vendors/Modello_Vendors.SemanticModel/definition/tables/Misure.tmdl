	measure 'Planned Events' = ```
			
			VAR LastRefreshDate = MAX(LastRefresh[LastRefresh])
			VAR SelectedPhase = SELECTEDVALUE('DIM_Events'[Events], "Submission")
			
			RETURN 
			SWITCH(
			    SelectedPhase,
			    "Issue", 
			        CALCULATE(
			            COUNTROWS('pbi F_DWH_REFERENCE_VENDORS'),
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE,
			            'pbi F_DWH_REFERENCE_VENDORS'[PLANNED_ISSUE_DATE] <= LastRefreshDate,
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_ISSUE_DATE])
			        ),
			    "Return", 
			        CALCULATE(
			            COUNTROWS('pbi F_DWH_REFERENCE_VENDORS'),
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE,
			            'pbi F_DWH_REFERENCE_VENDORS'[PLANNED_RETURN_DATE] <= LastRefreshDate,
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_RETURN_DATE])
			        ),
			    -- Default / Submission:
			    CALCULATE(
			        COUNTROWS('pbi F_DWH_REFERENCE_VENDORS'),
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE,
			        'pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE] <= LastRefreshDate,
			        NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE])
			    )
			)
			```
		formatString: 0
		displayFolder: Misure\Vendor Follow-Up
		lineageTag: 6356ca7c-0724-4046-8e92-43fed72f380e

