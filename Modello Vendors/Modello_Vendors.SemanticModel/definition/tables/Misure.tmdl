	measure 'Delay vs BL (Submission)' =
			
			VAR ViewMode    = SELECTEDVALUE('DIM_ViewMode'[ViewMode], "Pending")
			VAR LastRefresh = MAX(LastRefresh[LastRefresh])
			
			RETURN
			IF(
			    ViewMode = "Pending",
			    -- PENDING: In corso (senza Actual Submission)
			    AVERAGEX(
			        FILTER(
			            'pbi F_DWH_REFERENCE_VENDORS',
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE]) &&
			            ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE])
			        ),
			        DATEDIFF('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE], LastRefresh, DAY)
			    ),
			    -- OVERALL: Tutti i documenti
			    AVERAGEX(
			        FILTER(
			            'pbi F_DWH_REFERENCE_VENDORS',
			            'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			            NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE])
			        ),
			        VAR ActualDate  = 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]
			        VAR PlannedDate = 'pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE]
			        RETURN
			        IF(NOT ISBLANK(ActualDate), DATEDIFF(PlannedDate, ActualDate, DAY), DATEDIFF(PlannedDate, LastRefresh, DAY))
			    )
			)
		displayFolder: Misure\Vendor Follow-Up
		lineageTag: 86858236-7596-4104-895d-588597aef3bf

