			        NOT ISBLANK(IF('pbi F_DWH_REFERENCE_VENDORS'[TBD_WF_FLAG] = "P", 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_REVIEW_DATE], 'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_RESPONSE_DATE])) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_RETURN_TARGET]))
			    ), ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]) && ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]))
			)
		formatString: 0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 4572f5fc-b421-4ee1-aac6-3dbf11b1eb61

	/// BBP: average delay of pending documents: today - (previous milestone + target).
	measure 'WF DC Return Pending Delay (av.)' =
			VAR T0 = INT(MAX(LastRefresh[LastRefresh]))
			RETURN
			AVERAGEX(
			    FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        TRUE() &&
			        NOT ISBLANK(IF('pbi F_DWH_REFERENCE_VENDORS'[TBD_WF_FLAG] = "P", 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_REVIEW_DATE], 'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_RESPONSE_DATE])) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_RETURN_TARGET]))
			    ), ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]) && ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
			    DATEDIFF(IF('pbi F_DWH_REFERENCE_VENDORS'[TBD_WF_FLAG] = "P", 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_REVIEW_DATE], 'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_RESPONSE_DATE]) + RELATED('pbi PAR_WP'[TBD_RETURN_TARGET]), T0, DAY)
			)
		formatString: 0.0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 11223764-3a29-4059-9fd7-f4b66b31bcfb

	/// BBP: completed documents per delay bucket for DC Return (category = DIM_DelayBucket[Bucket]).
	measure 'WF DC Return Delay Docs' =
			VAR b = SELECTEDVALUE(DIM_DelayBucket[Bucket])
			RETURN
			COUNTROWS(
			    FILTER(
			        FILTER(FILTER(
			        'pbi F_DWH_REFERENCE_VENDORS',
			        'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE &&
			        TRUE() &&
			        NOT ISBLANK(IF('pbi F_DWH_REFERENCE_VENDORS'[TBD_WF_FLAG] = "P", 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_REVIEW_DATE], 'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_RESPONSE_DATE])) &&
			        NOT ISBLANK(RELATED('pbi PAR_WP'[TBD_RETURN_TARGET]))
			    ), NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE])),
			        VAR dl = DATEDIFF(IF('pbi F_DWH_REFERENCE_VENDORS'[TBD_WF_FLAG] = "P", 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_REVIEW_DATE], 'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_RESPONSE_DATE]) + RELATED('pbi PAR_WP'[TBD_RETURN_TARGET]), 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE], DAY)
			        RETURN
			            SWITCH(
			                TRUE(),
			                b = "On time", dl <= 0,
			                b = "Delay 0-7 dd", dl > 0 && dl <= 7,
			                b = "Delay 8-14 dd", dl > 7 && dl <= 14,
			                b = "Delay > 14 dd", dl > 14,
			                FALSE()
			            )
			    )
			)
		formatString: 0
		displayFolder: Claude BBP\5 Workflow
		lineageTag: 2403d1be-c554-4efb-9e7b-2749cf118260

	column Column
		isHidden
		formatString: 0
		lineageTag: c8eb0b88-5b8a-4dba-b42e-167b5a2ccada
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = User

	partition Misure = calculated
		mode: import
		source = Row("Column", BLANK())

