			    DISTINCTCOUNT('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]), 'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST]= TRUE,
			    NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]) ||
			    NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]) ||
