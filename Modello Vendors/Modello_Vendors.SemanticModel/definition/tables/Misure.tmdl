		lineageTag: 30a437a5-c5c3-4093-ac82-15ddc61c3629

	/// BBP: first Actual date (phase-based).
	measure 'DB Actual 1st Issue' =
			VAR Ev = SELECTEDVALUE(DIM_Events[Events], "Submission")
			RETURN SWITCH(
						    Ev,
						    "Issue", MIN('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]),
						    "Return", MIN('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]),
