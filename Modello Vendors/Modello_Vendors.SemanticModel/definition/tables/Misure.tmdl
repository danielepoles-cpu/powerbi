	/// Phase tracker: Actual Return empty and (Actual Issue present, or no issue foreseen: Actual Submission present and Planned Issue empty).
	measure 'Docs To Be Returned' = CALCULATE(DISTINCTCOUNT('pbi F_DWH_REFERENCE_VENDORS'[REFERENCE_NAME]), 'pbi F_DWH_REFERENCE_VENDORS'[IS_LATEST] = TRUE, ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_RETURN_DATE]), (NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]) || (NOT ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE]) && ISBLANK('pbi F_DWH_REFERENCE_VENDORS'[PLANNED_ISSUE_DATE]))))
