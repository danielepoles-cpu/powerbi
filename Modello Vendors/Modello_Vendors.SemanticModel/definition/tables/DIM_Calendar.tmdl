table DIM_Calendar
	lineageTag: a1f9930c-c501-4f79-b4b6-2d11930be4f7

	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: ffd0c938-b96c-4731-b631-6abde5b68a56
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Year
		dataType: int64
		formatString: 0
		lineageTag: a0d30752-1c3d-470e-a26b-9711a974044b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

		annotation SummarizationSetBy = Automatic

	column MonthNo
		dataType: int64
		formatString: 0
		lineageTag: ece93239-3991-455b-8c1f-40e9d5309126
		summarizeBy: none
		isNameInferred
		sourceColumn: [MonthNo]

		annotation SummarizationSetBy = Automatic

	column Month
		dataType: string
		lineageTag: 881f90a9-4cf8-41b1-8db4-9ccdc83ec123
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: YearMonth

		annotation SummarizationSetBy = Automatic

	column YearMonth
		dataType: int64
		formatString: 0
		lineageTag: b90cb1eb-cb7d-4f87-944c-94fd031b2461
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth]

		annotation SummarizationSetBy = Automatic

	hierarchy Year-Month
		lineageTag: 6e65b079-2e2c-4a66-af7a-04b1b145ac89

		level Year
			lineageTag: 3baafc70-e2e4-4ba3-a06d-ada1390ba84f
			column: Year

		level Month
			lineageTag: d4d94674-5225-4e62-b86c-1fc165ab4b5a
			column: Month

	partition DIM_Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS(
				    CALENDAR(DATE(2023, 1, 1), DATE(2030, 12, 31)),
				    "Year", YEAR([Date]),
				    "MonthNo", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM yyyy"),
				    "YearMonth", YEAR([Date]) * 100 + MONTH([Date])
				)

	annotation PBI_Id = 6989175faa8c45978d8e52801a0b0cd8

