	column ACTUAL_RETURN_DATE
		dataType: dateTime
		formatString: Long Date
		lineageTag: edf5388d-b9ae-4209-ad4f-375e9e97baac
		summarizeBy: none
		sourceColumn: ACTUAL_RETURN_DATE

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column PLANNED_RETURN_DATE =
			
			VAR SubmissionDate = 'pbi F_DWH_REFERENCE_VENDORS'[PLANNED_SUBMISSION_DATE]
			VAR TargetDays = RELATED('pbi PAR_WP'[RM_RETURN_TAP])
			
			RETURN
			    IF(
			        ISBLANK(SubmissionDate),
			        BLANK(),
			        SubmissionDate + TargetDays
			    )
		formatString: General Date
		lineageTag: 5004d359-fb67-4ac7-a209-4a7402c555e5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column PLANNED_CPY_REPLY_DATE =
			
			VAR IsReplyNeeded = 'pbi F_DWH_REFERENCE_VENDORS'[CLIENT_REPLY_REQUIRED] <> "N"
			VAR ActualIssue   = 'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_ISSUE_DATE]
			VAR CustomerTap   = RELATED('pbi PAR_WP'[CUSTOMER_TAP])
			
			RETURN
			IF(
			    IsReplyNeeded && NOT ISBLANK(ActualIssue),
			    ActualIssue + CustomerTap,
			    BLANK()
			)
		formatString: General Date
		lineageTag: 4c965b49-15bf-4cc4-8bdc-9879ef2d9199
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column FORECAST_RETURN_DATE = ```
			
			-- 1. Definizione della BaseDate: priorità a Actual Submission, altrimenti Forecast Submission
			VAR BaseDate = 
			    COALESCE(
			        'pbi F_DWH_REFERENCE_VENDORS'[ACTUAL_SUBMISSION_DATE],
			        'pbi F_DWH_REFERENCE_VENDORS'[FORECAST_SUBMISSION_DATE]
			    )
			
			-- 2. Recupero dei giorni Target dalla tabella TAP (es. 'PAR_WP'[RM_RETURN_TAP] o simile)
			VAR TargetDays = RELATED('pbi PAR_WP'[RM_RETURN_TAP])
			
			RETURN
			-- 3. Se la BaseDate non è valorizzata (o se non ci sono giorni TAP), restituisce BLANK
			IF(
			    NOT ISBLANK(BaseDate) && NOT ISBLANK(TargetDays),
			    BaseDate + TargetDays,
			    BLANK()
			)
			```
		formatString: General Date
		lineageTag: a5b3d1da-1361-4792-90c6-138f8ea32900
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

