table DIM_Weeks
	lineageTag: 943bf4cf-d525-44b7-bafe-b374dd14f3e7

	column WeekNo
		dataType: int64
		formatString: 0
		lineageTag: 011e41af-99ee-477e-aa12-d22ee744dae4
		summarizeBy: none
		isNameInferred
