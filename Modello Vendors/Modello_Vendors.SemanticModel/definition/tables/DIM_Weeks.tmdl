	partition DIM_Weeks = calculated
		mode: import
		source =
				SELECTCOLUMNS(
				    GENERATESERIES(0, 10, 1),
				    "WeekNo", [Value],
				    "Week", IF([Value] = 0, "Today", "W" & [Value])
				)

